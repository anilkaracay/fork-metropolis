# pnpm test:dev supplies an isolated workspace without credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FORK_PHASE=live-integration

# Phase 3: configure locally, then confirm variable presence without sharing values.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# pnpm db:up securely configures local PostgreSQL DATABASE_URL in .env.local.
# Production supplies a standard PostgreSQL URL via server-only environment.
# DATABASE_URL=postgresql://...
# Canonical existing Monad Testnet deployment; public, not a credential.
FORK_REGISTRY_ADDRESS=0x1889a7216b1ecad9a44910dd0996834d0894b9e1
# Public Envio development-tier endpoint for the existing demonstration.
FORK_ENVIO_URL=https://indexer.dev.hyperindex.xyz/da86abe/v1/graphql
# Optional permitted Nansen profile context; key stays server-only.
# NANSEN_API_KEY=
FORK_NANSEN_DAILY_CREDIT_BUDGET=20
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Comma-separated verified Privy DIDs; server-only moderator allowlist.
FORK_ADMIN_DIDS=
# Optional testnet-only welcome faucet key (0x + 64 hex). Server-only; never commit a value.
# FORK_FAUCET_PRIVATE_KEY=
# Never set FORK_TEST_MODE in a production environment.
