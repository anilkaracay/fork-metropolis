# pnpm test:dev supplies an isolated workspace without credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FORK_PHASE=live-integration

# Phase 3: configure locally, then confirm variable presence without sharing values.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# DATABASE_URL=postgresql://...
# FORK_REGISTRY_ADDRESS=0x...
# FORK_ENVIO_URL=https://...
