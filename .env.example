# Web variables belong in apps/web/.env.local (see apps/web/.env.example).
# No secrets are needed for pnpm test:dev or unit/database/handler tests.
# Explicit CLI-only database configuration for a later authorized migration:
# DATABASE_URL=postgresql://...
# Live indexer values, after an authorized registry deployment:
# ENVIO_FORK_REGISTRY_ADDRESS=0x...
# ENVIO_FORK_START_BLOCK=
