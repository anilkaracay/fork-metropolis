{
  "name": "@fork/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../apps/web/.env.local --experimental-strip-types src/migrate.ts",
    "smoke": "node --env-file-if-exists=../../apps/web/.env.local --experimental-strip-types src/smoke.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1"
  }
}
